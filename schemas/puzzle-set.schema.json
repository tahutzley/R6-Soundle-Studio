{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r6soundle.example/schemas/puzzle-set.schema.json",
  "title": "R6 Soundle Puzzle Set",
  "type": "object",
  "required": ["id", "kind", "name", "mapSlug", "version", "status", "rounds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["daily", "example"], "description": "Daily sets contain three rounds; examples contain one round and are reserved for How to Play." },
    "name": { "type": "string", "minLength": 1 },
    "mapSlug": { "type": "string", "minLength": 1 },
    "mapAssetVersion": { "type": "string", "minLength": 1 },
    "importedMapSet": { "type": "string", "pattern": "^[1-9][0-9]*-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "importFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "ready", "approved", "archived"] },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/round" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "daily" } } },
      "then": { "properties": { "rounds": { "minItems": 3, "maxItems": 3 } } },
      "else": { "properties": { "rounds": { "minItems": 1, "maxItems": 1 } } }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "required": ["x", "y", "floorKey"],
      "properties": {
        "x": { "type": "number", "description": "Coordinate in the calibrated square frame; full wide-map edges may fall outside 0–1." },
        "y": { "type": "number", "description": "Coordinate in the calibrated square frame; full wide-map edges may fall outside 0–1." },
        "floorKey": { "type": "string", "minLength": 1 },
        "angle": { "type": "number" }
      }
    },
    "round": {
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 3 },
        "operatorId": { "type": ["string", "null"] },
        "listenerPos": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }] },
        "operatorStartPos": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }] },
        "targetPos": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }] },
        "alternateTargetFloorKey": { "type": ["string", "null"], "minLength": 1, "description": "Optional second floor accepted for a runner end placed between floors, using the target position's coordinates." },
        "guessPos": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }], "description": "Authored result guess used only by How to Play examples." },
        "captureId": { "type": ["string", "null"] }
      }
    }
  }
}
