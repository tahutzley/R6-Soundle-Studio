{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r6soundle.example/schemas/capture.schema.json",
  "title": "R6 Soundle Processed Capture",
  "type": "object",
  "required": ["id", "status", "evidence", "replay", "alignment"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["processing", "needs_review", "approved", "failed"] },
    "evidence": {
      "type": "object",
      "required": ["stillPath", "audioPath"],
      "properties": {
        "stillPath": { "type": "string" },
        "audioPath": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "required": ["videoPath"],
      "properties": { "videoPath": { "type": "string" } }
    },
    "alignment": {
      "type": "object",
      "required": ["runnerOffsetMs", "confidence"],
      "properties": {
        "runnerOffsetMs": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
